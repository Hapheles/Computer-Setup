<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="IPC Setup 101" 
    Height="800" 
    Width="1000"
    WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <!-- Category Header Style -->
        <Style x:Key="CategoryHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2c3e50"/>
            <Setter Property="Margin" Value="0,20,0,10"/>
        </Style>
        
        <!-- Category Badge Style -->
        <Style x:Key="CategoryBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#3498db"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        
        <!-- Software Card Style -->
        <Style x:Key="SoftwareCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#e0e0e0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="2" Color="#CCCCCC" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Install Button Style -->
        <Style x:Key="InstallButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#27ae60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2ecc71"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#27ae60"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Separator Style -->
        <Style x:Key="CategorySeparatorStyle" TargetType="Border">
            <Setter Property="Height" Value="2"/>
            <Setter Property="Background" Value="#bdc3c7"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="IPC Configurations and Setup" 
                   FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>
        
        <!-- Tab Control -->
        <TabControl Grid.Row="1" Margin="0,10">
            
            <!-- Software Installation Tab -->
            <TabItem Header="Software Installation">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Software List with Scroll -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="SoftwarePanel" Orientation="Vertical">
                            <!-- Software will be dynamically added here -->
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </TabItem>
            
            <!-- System Settings Tab -->
            <TabItem Header="System Settings">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
        
                    <!-- Settings Header -->
                    <TextBlock Grid.Row="0" Text="System Configuration And Tweaks" 
                    FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
        
                    <!-- Tweaks Options -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TweaksPanel" Orientation="Vertical">
                            <!-- Tweaks will be dynamically added here -->
                        </StackPanel>
                    </ScrollViewer>
        
                    <!-- Quick Actions Section -->
                    <GroupBox Grid.Row="2" Header="Network Settings and Configurations" Margin="0,10,0,5">
                        <StackPanel Orientation="Vertical" Margin="5">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ButtonFlushDNS" Content="Flush DNS" 
                                        Width="100" Height="25" Margin="5" 
                                        ToolTip="Clear DNS resolver cache"/>
                                <Button x:Name="ButtonResetWinsock" Content="Reset Winsock" 
                                        Width="110" Height="25" Margin="5" 
                                        ToolTip="Reset Windows Sockets API"/>
                                <Button x:Name="ButtonNetworkReset" Content="Network Reset" 
                                        Width="110" Height="25" Margin="5" 
                                        ToolTip="Reset network adapters and settings"/>
                                <Button x:Name="ButtonIPV6Reset" Content="Disable IPv6" 
                                        Width="100" Height="25" Margin="5" 
                                        ToolTip="Disable IPv6 on all network adapters"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Utilities -->
                    <GroupBox Grid.Row="3" Header="Utilities Setup and Configurations" Margin="0,10,0,5">
                        <StackPanel Orientation="Vertical" Margin="5">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ButtonEventViewerRegistryPermissions" Content="EventViewerPermit" 
                                        Width="150" Height="25" Margin="5"
                                        ToolTip="Allow permissions for everyone in Event Viewer"/>
                                <Button x:Name="InstallMSMQComponents" Content="Install MSMQ Components" 
                                        Width="150" Height="25" Margin="5"
                                        ToolTip="Install Core MSMQ Components"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Power Options -->
                    <GroupBox Grid.Row="4" Header="Power Options" Margin="0,10,0,5">
                        <StackPanel Orientation="Horizontal">
                                <Button x:Name="ButtonHighPerformance" Content="High Performance Power" 
                                    Width="150" Height="25" Margin="5"
                                    ToolTip="Change Power Mode to High Performance"/>
                                <Button x:Name="ButtonTurnOffSleep" Content="Turn Off Sleep Mode" 
                                    Width="150" Height="25" Margin="5"
                                    ToolTip="Turn Off Sleep Mode"/>
                                <Button x:Name="DisableHardDiskTimeout" Content="Disable Hard Disk Timeout" 
                                    Width="150" Height="25" Margin="5"
                                    ToolTip="Disables Hard Disk Timeout after a certain period"/>
                        </StackPanel>
                    </GroupBox>
        
                    <!-- Settings Action Buttons -->
                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="ButtonApplyTweaks" Content="Apply Selected Tweaks" 
                                Width="140" Height="25" Margin="5"/>
                        <Button x:Name="ButtonResetSettings" Content="Reset Selection" 
                                Width="100" Height="25" Margin="5"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Windows and Microsoft Activation -->
            <TabItem Header="Activation" Name="TabActivation">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <TextBlock Text="Windows Activation" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="Select an activation method below and click 'Run Activation'" 
                        TextWrapping="Wrap" Margin="0,0,0,15" Foreground="Gray"/>
            
                    <!-- Activation scripts will be loaded here -->
                    <StackPanel Name="ActivationPanel" Margin="0,0,0,15"/>
            
                        <Button Name="ButtonRunActivation" Content="Run Selected Activation" 
                            HorizontalAlignment="Left" Padding="15,5" FontWeight="Bold"
                            Background="#FF28A745" Foreground="White"/>
            
                        <TextBlock Text="Note: Some activation methods require internet connection." 
                            TextWrapping="Wrap" Margin="0,15,0,0" FontStyle="Italic" Foreground="OrangeRed"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        
        </TabControl>
        
        <!-- Global Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ButtonExit"
            Content="Exit" 
            Width="60" 
            Height="25" 
            Margin="5"/>
        </StackPanel>
    </Grid>
</Window>